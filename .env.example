# ─────────────────────────────────────────────────────────────
# AI Groupmate — environment template
# Copy to .env and fill in real values. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────

# ── Discord ──────────────────────────────────────────────────
# Get from https://discord.com/developers/applications → your app → Bot → Token
DISCORD_BOT_TOKEN=replace_me

# Your bot's client ID (app ID) — used for mention detection
DISCORD_APP_ID=1548738571127496787

# Comma-separated Discord user IDs who can run admin commands
# (e.g. /remember, /forget, enable/disable channels, approve style)
DISCORD_ADMIN_IDS=1285571443366559751

# Default test guild ID — restricts slash commands to this server during dev
DISCORD_TEST_GUILD_ID=1394484126760828928

GROQ_API_KEY=replace_me

GROQ_MODEL=llama-3.3-70b-versatile

# Generation defaults
LLM_MAX_TOKENS=400
LLM_TEMPERATURE=0.7

# ── Database ──────────────────────────────────────────────────
# SQLite for dev. Swap to postgresql+asyncpg://... for prod.
DATABASE_URL=sqlite+aiosqlite:///./data/groupmate.db

# ── Conversation tuning ─────────────────────────────────────
# How many recent messages to keep in the per-channel rolling buffer
CONTEXT_BUFFER_SIZE=20

# Max tokens of recent context to send to the LLM (excluding system prompt)
CONTEXT_MAX_TOKENS=2000

# Cooldown (seconds) between bot replies in the same channel
REPLY_COOLDOWN_SECONDS=2

# Max replies per minute per channel (rate limit)
MAX_REPLIES_PER_MINUTE=10

# ── Logging ──────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Optional: enable Phase 2+ features early (not implemented in Phase 1) ──
ENABLE_STYLE_LEARNING=true
ENABLE_LONG_TERM_MEMORY=true
ENABLE_CONVERSATION_SUMMARIES=true
ENABLE_AUTONOMOUS_PARTICIPATION=false
ENABLE_REACT_OUTCOME=true
ENABLE_LLM_DECISION_ASSIST=false

# ── Phase 3: Tools ──────────────────────────────────────────
ENABLE_TOOLS=true
ENABLE_REMINDERS=true
ENABLE_TIMERS=true
TOOL_MAX_ITERATIONS=3

# ── Phase 3: Scheduler ───────────────────────────────────────
# IANA timezone for natural-language time parsing ("tomorrow at 8pm")
USER_TIMEZONE=Australia/Sydney
SCHEDULER_JOB_INTERVAL=5.0

# ── Phase 4: Custom API tools ───────────────────────────────
ENABLE_CUSTOM_API_TOOLS=true
HTTP_TOOL_TIMEOUT_SECONDS=8.0
HTTP_TOOL_MAX_RESPONSE_BYTES=16384

# ── Phase 4: Memory extraction ──────────────────────────────
ENABLE_MEMORY_EXTRACTION=true
MEMORY_EXTRACTION_TRIGGER_MESSAGE_COUNT=15
MEMORY_EXTRACTION_MAX_PROPOSALS_PER_RUN=3

# ── Phase 4: Topic tracking ────────────────────────────────
ENABLE_TOPIC_TRACKING=true
TOPIC_KEYWORDS_COUNT=5

# ── Phase 4: Per-user language preferences ─────────────────
ENABLE_PER_USER_LANGUAGE=true
